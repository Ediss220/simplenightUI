{
  "name": "simplenight-ui-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI automation framework for Simplenight booking flows",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:parallel": "playwright test --workers=50%",
    "test:headless": "cross-env CI=true playwright test",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');for(const d of ['test-results','playwright-report'])fs.rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.0.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.0"
  }
}
